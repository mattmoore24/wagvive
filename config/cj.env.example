# Copy to config/cj.env and fill in real values.
# config/cj.env is gitignored and must NEVER be committed.
#
# CJ_API_KEY comes from CJ Dropshipping > My CJ > Authorization / API.
# The access token derived from these is cached in config/cj_token.json
# (also gitignored) and refreshed automatically by config/cj_api.py.
#
# NOTE: CJ rate-limits token creation. Scheduled jobs should run at most
# every few hours, not every few minutes, or auth will start failing.

CJ_EMAIL=you@example.com
CJ_API_KEY=replace_me
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
