# Copy to config/shopify.env and fill in real values.
# config/shopify.env is gitignored and must NEVER be committed.
#
# Where these come from:
#   SHOPIFY_ADMIN_API_TOKEN  Shopify admin > Settings > Apps and sales channels
#                            > Develop apps > <your app> > API credentials.
#                            Starts with "shpat_".
#   SHOPIFY_STORE_DOMAIN     The myshopify domain, not the custom domain.
#   SHOPIFY_API_VERSION      Pin a version; bumping it can change field names.

SHOPIFY_ADMIN_API_TOKEN=shpat_replace_me
SHOPIFY_STORE_DOMAIN=abezff-5d.myshopify.com
SHOPIFY_API_VERSION=2026-07
