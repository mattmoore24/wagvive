<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Your Wagvive shipment was updated</title>
</head>
<body style="margin:0; padding:0; width:100%; background-color:#EFE7DA; -webkit-font-smoothing:antialiased;">

<div style="display:none; font-size:1px; color:#EFE7DA; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;">There is an update on your Wagvive shipment.</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#EFE7DA;">
<tr><td align="center" style="padding:28px 12px 40px 12px;">
  <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#F7F2E9; border-radius:14px; overflow:hidden;">

    <tr><td align="center" style="padding:34px 32px 6px 32px;">
      <a href="{{ shop.url }}" style="text-decoration:none;">
        <img src="https://cdn.shopify.com/s/files/1/0994/5114/2433/t/1/assets/email-wordmark.png" width="180" alt="Wagvive" style="display:block; border:0; width:180px; max-width:180px; height:auto;">
      </a>
    </td></tr>

    <tr><td align="center" style="padding:14px 32px 0 32px;">
      <h1 style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:27px; line-height:34px; font-weight:400; color:#3A3026;">A quick shipping update.</h1>
      <p style="margin:10px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:15px; line-height:24px; color:#6B5F51;">The carrier has new information about your parcel. The latest tracking is below.</p>
      <p style="margin:16px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; line-height:20px; color:#8A7B6B; letter-spacing:0.04em; text-transform:uppercase;">Order {{ order_name }}</p>
    </td></tr>

    <tr><td style="padding:24px 32px 0 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#EFE7DA; border-radius:10px;">
        <tr><td align="center" style="padding:22px 20px;">
          {% if fulfillment.tracking_number %}
          <p style="margin:0 0 4px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#8A7B6B;">Tracking number</p>
          <p style="margin:0 0 16px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:17px; line-height:24px; font-weight:600; color:#3A3026; word-break:break-all;">{{ fulfillment.tracking_number }}</p>
          {% endif %}
          {% if fulfillment.tracking_url %}
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
        <tr><td align="center" bgcolor="#3A3026" style="border-radius:999px;">
          <a href="{{ fulfillment.tracking_url }}" style="display:inline-block; padding:14px 34px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:15px; font-weight:600; color:#F7F2E9; text-decoration:none; border-radius:999px;">Track your package</a>
        </td></tr>
      </table>
          {% else %}
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
        <tr><td align="center" bgcolor="#3A3026" style="border-radius:999px;">
          <a href="{{ order_status_url }}" style="display:inline-block; padding:14px 34px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:15px; font-weight:600; color:#F7F2E9; text-decoration:none; border-radius:999px;">View your order</a>
        </td></tr>
      </table>
          {% endif %}
          {% if fulfillment.tracking_company %}
          <p style="margin:14px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; line-height:19px; color:#6B5F51;">Carrier: {{ fulfillment.tracking_company }}</p>
          {% endif %}
        </td></tr>
      </table>
    </td></tr>    <tr><td style="padding:26px 32px 0 32px;">
      <p style="margin:0 0 12px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#8A7B6B;">In this shipment</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {% for line in fulfillment.fulfillment_line_items %}
        <tr>
          <td width="64" valign="top" style="padding:10px 14px 10px 0;">
            {% if line.line_item.image %}
              <img src="{{ line.line_item | img_url: 'compact_cropped' }}" width="64" height="64" alt="{{ line.line_item.title | escape }}" style="display:block; border:0; width:64px; height:64px; border-radius:8px; background-color:#EFE7DA;">
            {% endif %}
          </td>
          <td valign="top" style="padding:10px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;">
            <div style="font-size:15px; line-height:21px; color:#3A3026; font-weight:600;">{{ line.line_item.title }}</div>
            {% if line.line_item.variant.title != 'Default Title' %}<div style="font-size:13px; line-height:19px; color:#6B5F51;">{{ line.line_item.variant.title }}</div>{% endif %}
            <div style="font-size:13px; line-height:19px; color:#8A7B6B;">Qty {{ line.quantity }}</div>
          </td>
        </tr>
        {% endfor %}
      </table>
    </td></tr>

    <tr><td style="padding:26px 32px 0 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #E2D8C8;">
        <tr><td style="padding:20px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:14px; line-height:22px; color:#6B5F51;">
          Questions? Reply to this email or write to <a href="mailto:hello@wagvive.com" style="color:#3A3026; font-weight:600; text-decoration:underline;">hello@wagvive.com</a> and a real person will get back to you.
        </td></tr>
      </table>
    </td></tr>

    <tr><td align="center" style="padding:26px 32px 34px 32px;">
      <p style="margin:0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; line-height:19px; color:#8A7B6B;">
        <a href="{{ shop.url }}" style="color:#8A7B6B; text-decoration:none;">wagvive.com</a> &nbsp;·&nbsp;
        <a href="{{ shop.url }}/policies/refund-policy" style="color:#8A7B6B; text-decoration:none;">Returns</a> &nbsp;·&nbsp;
        <a href="{{ shop.url }}/pages/faq" style="color:#8A7B6B; text-decoration:none;">FAQ</a>
      </p>
      <p style="margin:8px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; line-height:19px; color:#A2957F;">Wagvive · Dog gear worth keeping</p>
    </td></tr>

  </table>
</td></tr>
</table>
</body>
</html>
