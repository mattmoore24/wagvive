{% comment %}
  Wagvive — Order confirmation
  Paste into: Settings → Notifications → Order confirmation → Edit code (HTML tab)
  Replace the ENTIRE contents of the editor with this file.

  Design notes (why it is built this way):
  - Table-based layout + inline CSS: Outlook ignores <style> blocks and flexbox/grid.
  - 600px max width, single column: the safest width across Gmail/Apple Mail/Outlook.
  - Palette: cream #F7F2E9 surface, ink #3A3026 text, matching the storefront.
  - A light card on a light page survives dark-mode inversion far better than dark-on-dark.
  - Delivery promise wording matches the site and policies exactly ("10 to 16 business days"). Source: config/delivery_promise.py.
{% endcomment %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Order {{ order_name }}</title>
</head>
<body style="margin:0; padding:0; width:100%; background-color:#EFE7DA; -webkit-font-smoothing:antialiased;">

<div style="display:none; font-size:1px; color:#EFE7DA; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;">
  Thanks {{ customer.first_name }} — order {{ order_name }} is confirmed and arrives in 10 to 16 business days.
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#EFE7DA;">
<tr><td align="center" style="padding:28px 12px 40px 12px;">

  <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#F7F2E9; border-radius:14px; overflow:hidden;">

    <!-- wordmark -->
    <tr><td align="center" style="padding:34px 32px 6px 32px;">
      <a href="{{ shop.url }}" style="text-decoration:none;">
        <img src="https://cdn.shopify.com/s/files/1/0994/5114/2433/t/1/assets/email-wordmark.png"
             width="180" alt="Wagvive"
             style="display:block; border:0; width:180px; max-width:180px; height:auto;">
      </a>
    </td></tr>

    <!-- headline -->
    <tr><td align="center" style="padding:14px 32px 0 32px;">
      <h1 style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:27px; line-height:34px; font-weight:400; color:#3A3026;">
        Thanks{% if customer.first_name %}, {{ customer.first_name }}{% endif %}.
      </h1>
      <p style="margin:10px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:15px; line-height:24px; color:#6B5F51;">
        Your order is confirmed. We are getting it ready now, and you will hear from us
        again the moment it ships.
      </p>
      <p style="margin:16px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:13px; line-height:20px; color:#8A7B6B; letter-spacing:0.04em; text-transform:uppercase;">
        Order {{ order_name }}
      </p>
    </td></tr>

    <!-- delivery promise -->
    <tr><td style="padding:22px 32px 0 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
             style="background-color:#EFE7DA; border-radius:10px;">
        <tr><td align="center" style="padding:16px 20px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:14px; line-height:21px; color:#3A3026;">
          <strong style="font-weight:600;">Arrives in 10 to 16 business days.</strong><br>
          <span style="color:#6B5F51;">Tracking lands in your inbox as soon as it leaves the warehouse.</span>
        </td></tr>
      </table>
    </td></tr>

    <!-- line items -->
    <tr><td style="padding:26px 32px 0 32px;">
      <p style="margin:0 0 12px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#8A7B6B;">
        What is coming
      </p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {% for line in subtotal_line_items %}
        <tr>
          <td width="64" valign="top" style="padding:10px 14px 10px 0;">
            {% if line.image %}
              <img src="{{ line | img_url: 'compact_cropped' }}" width="64" height="64" alt="{{ line.title | escape }}"
                   style="display:block; border:0; width:64px; height:64px; border-radius:8px; background-color:#EFE7DA;">
            {% endif %}
          </td>
          <td valign="top" style="padding:10px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;">
            <div style="font-size:15px; line-height:21px; color:#3A3026; font-weight:600;">{{ line.title }}</div>
            {% if line.variant.title != 'Default Title' %}
              <div style="font-size:13px; line-height:19px; color:#6B5F51;">{{ line.variant.title }}</div>
            {% endif %}
            <div style="font-size:13px; line-height:19px; color:#8A7B6B;">Qty {{ line.quantity }}</div>
          </td>
          <td valign="top" align="right" style="padding:10px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:15px; line-height:21px; color:#3A3026; white-space:nowrap;">
            {{ line.final_line_price | money }}
          </td>
        </tr>
        {% endfor %}
      </table>
    </td></tr>

    <!-- totals -->
    <tr><td style="padding:8px 32px 0 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
             style="border-top:1px solid #E2D8C8; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;">
        <tr>
          <td style="padding:14px 0 3px 0; font-size:14px; color:#6B5F51;">Subtotal</td>
          <td align="right" style="padding:14px 0 3px 0; font-size:14px; color:#3A3026;">{{ subtotal_price | money }}</td>
        </tr>
        {% for discount_application in discount_applications %}
        <tr>
          <td style="padding:3px 0; font-size:14px; color:#6B5F51;">
            Discount{% if discount_application.title %} ({{ discount_application.title }}){% endif %}
          </td>
          <td align="right" style="padding:3px 0; font-size:14px; color:#3A3026;">-{{ discount_application.total_allocated_amount | money }}</td>
        </tr>
        {% endfor %}
        <tr>
          <td style="padding:3px 0; font-size:14px; color:#6B5F51;">Shipping</td>
          <td align="right" style="padding:3px 0; font-size:14px; color:#3A3026;">
            {% if shipping_price > 0 %}{{ shipping_price | money }}{% else %}Free{% endif %}
          </td>
        </tr>
        {% if tax_price > 0 %}
        <tr>
          <td style="padding:3px 0; font-size:14px; color:#6B5F51;">Tax</td>
          <td align="right" style="padding:3px 0; font-size:14px; color:#3A3026;">{{ tax_price | money }}</td>
        </tr>
        {% endif %}
        <tr>
          <td style="padding:12px 0 0 0; border-top:1px solid #E2D8C8; font-size:16px; font-weight:600; color:#3A3026;">Total</td>
          <td align="right" style="padding:12px 0 0 0; border-top:1px solid #E2D8C8; font-size:16px; font-weight:600; color:#3A3026;">{{ total_price | money }}</td>
        </tr>
      </table>
    </td></tr>

    <!-- CTA -->
    <tr><td align="center" style="padding:26px 32px 0 32px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr><td align="center" bgcolor="#3A3026" style="border-radius:999px;">
          <a href="{{ order_status_url }}"
             style="display:inline-block; padding:14px 34px; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:15px; font-weight:600; color:#F7F2E9; text-decoration:none; border-radius:999px;">
            View your order
          </a>
        </td></tr>
      </table>
    </td></tr>

    <!-- shipping address -->
    {% if requires_shipping and shipping_address %}
    <tr><td style="padding:28px 32px 0 32px;">
      <p style="margin:0 0 6px 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#8A7B6B;">
        Shipping to
      </p>
      <p style="margin:0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:14px; line-height:21px; color:#3A3026;">
        {{ shipping_address.name }}<br>
        {{ shipping_address.street }}<br>
        {{ shipping_address.city }}, {{ shipping_address.province_code }} {{ shipping_address.zip }}
      </p>
    </td></tr>
    {% endif %}

    <!-- help -->
    <tr><td style="padding:26px 32px 0 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #E2D8C8;">
        <tr><td style="padding:20px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:14px; line-height:22px; color:#6B5F51;">
          Questions about your order? Reply to this email or write to
          <a href="mailto:hello@wagvive.com" style="color:#3A3026; font-weight:600; text-decoration:underline;">hello@wagvive.com</a>
          and a real person will get back to you.
        </td></tr>
      </table>
    </td></tr>

    <!-- footer -->
    <tr><td align="center" style="padding:26px 32px 34px 32px;">
      <p style="margin:0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; line-height:19px; color:#8A7B6B;">
        <a href="{{ shop.url }}" style="color:#8A7B6B; text-decoration:none;">wagvive.com</a>
        &nbsp;·&nbsp;
        <a href="{{ shop.url }}/policies/refund-policy" style="color:#8A7B6B; text-decoration:none;">Returns</a>
        &nbsp;·&nbsp;
        <a href="{{ shop.url }}/pages/faq" style="color:#8A7B6B; text-decoration:none;">FAQ</a>
      </p>
      <p style="margin:8px 0 0 0; font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:12px; line-height:19px; color:#A2957F;">
        Wagvive · Dog gear worth keeping
      </p>
    </td></tr>

  </table>

</td></tr>
</table>
</body>
</html>
