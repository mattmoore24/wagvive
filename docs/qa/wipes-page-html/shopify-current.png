    <div class="details-content">
      








  <rte-formatter class=" spacing-style text-block text-block--ANVVmRUF1WFhzYWMzS__a rte    text-block--align-left rte   "  style="    --padding-block-start: 0px; --padding-block-end:0px; --padding-inline-start:0px; --padding-inline-end:0px;              --color: #33332D;      --color-rgb: 51 51 45;        --width: 100%;    --max-width: var(--max-width--body-normal);          --text-align: left;          ">
    <p>Dispatched in 1&ndash;3 business days. Typical US delivery is 5&ndash;12 business days after dispatch, with tracking emailed as soon as it ships. Free over $60, otherwise $5.95 flat.</p>
  </rte-formatter>







