    <div class="details-content">
      








  <rte-formatter class=" spacing-style text-block text-block--AVHNCTEdQWU5McFVYZ__a rte    text-block--align-left rte   "  style="    --padding-block-start: 0px; --padding-block-end:0px; --padding-inline-start:0px; --padding-inline-end:0px;              --color: #33332D;      --color-rgb: 51 51 45;        --width: 100%;    --max-width: var(--max-width--body-normal);          --text-align: left;          ">
    <p>30 days from delivery. Faulty, damaged, or incorrect items: we cover return shipping and replace or refund, your choice. Changed your mind is fine too &mdash; return postage is on you in that case.</p>
  </rte-formatter>







